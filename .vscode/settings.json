// Place your settings in this file to overwrite default and user settings.
{
	"files.exclude": {
		"out": false // set this to true to hide the "out" folder with the compiled JS files
	},
	"search.exclude": {
		"out": true // set this to false to include "out" folder in search results
	},
	// Turn off tsc task auto detection since we have the necessary tasks as npm scripts
	"typescript.tsc.autoDetect": "off",
	"workbench.colorCustomizations": {
		"activityBar.background": "#464F0E",
		"titleBar.activeBackground": "#626F13",
		"titleBar.activeForeground": "#F9FBEA",
		"titleBar.inactiveBackground": "#464F0E",
		"titleBar.inactiveForeground": "#F9FBEA",
		"statusBar.background": "#464F0E",
		"statusBar.foreground": "#F9FBEA",
		"statusBar.debuggingBackground": "#464F0E",
		"statusBar.debuggingForeground": "#F9FBEA",
		"statusBar.noFolderBackground": "#464F0E",
		"statusBar.noFolderForeground": "#F9FBEA"
	}
}
